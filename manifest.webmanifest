{
  "id": "./",
  "name": "Calculator — Standard, Pro & Convert",
  "short_name": "Calculator",
  "description": "A monochrome calculator with standard, professional and converter modes. Works offline.",
  "start_url": "./",
  "scope": "./",
  "display": "standalone",
  "display_override": ["standalone", "minimal-ui"],
  "orientation": "portrait-primary",
  "background_color": "#0d0e10",
  "theme_color": "#0d0e10",
  "lang": "en",
  "dir": "ltr",
  "categories": ["utilities", "productivity", "education"],
  "prefer_related_applications": false,
  "launch_handler": { "client_mode": "navigate-existing" },
  "icons": [
    { "src": "icon.svg", "sizes": "any", "type": "image/svg+xml", "purpose": "any" },
    { "src": "icon-192.png", "sizes": "192x192", "type": "image/png", "purpose": "any" },
    { "src": "icon-512.png", "sizes": "512x512", "type": "image/png", "purpose": "any" },
    { "src": "icon-maskable-192.png", "sizes": "192x192", "type": "image/png", "purpose": "maskable" },
    { "src": "icon-maskable-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" },
    { "src": "icon-mono-192.png", "sizes": "192x192", "type": "image/png", "purpose": "monochrome" },
    { "src": "icon-mono-512.png", "sizes": "512x512", "type": "image/png", "purpose": "monochrome" }
  ],
  "shortcuts": [
    {
      "name": "Pro mode",
      "short_name": "Pro",
      "url": "./?mode=pro",
      "icons": [{ "src": "icon-192.png", "sizes": "192x192", "type": "image/png" }]
    },
    {
      "name": "Convert",
      "short_name": "Convert",
      "url": "./?mode=convert",
      "icons": [{ "src": "icon-192.png", "sizes": "192x192", "type": "image/png" }]
    }
  ]
}
